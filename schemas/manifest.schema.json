{
  "$defs": {
    "Attribute": {
      "additionalProperties": false,
      "description": "Named device-state primitive: read / write / subscribe.\n\nThe shape is accepted so authors and editors can work with it, but the\nruntime rejects manifests that declare attributes until support lands\n(see :func:`_check_reserved_primitives`).",
      "properties": {
        "audience": {
          "items": {
            "pattern": "^[a-z][a-z0-9_-]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Audience",
          "type": "array"
        },
        "ble": {
          "patternProperties": {
            "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$": {
              "$ref": "#/$defs/BleAttributeSpec"
            }
          },
          "title": "Ble",
          "type": "object"
        },
        "capabilities": {
          "items": {
            "type": "string"
          },
          "title": "Capabilities",
          "type": "array"
        },
        "handler": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Handler"
        },
        "http": {
          "patternProperties": {
            "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$": {
              "$ref": "#/$defs/HttpAttributeSpec"
            }
          },
          "title": "Http",
          "type": "object"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$",
          "title": "Id",
          "type": "string"
        },
        "operations": {
          "items": {
            "enum": [
              "read",
              "write",
              "subscribe"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Operations",
          "type": "array"
        },
        "transports": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Transports",
          "type": "array"
        }
      },
      "required": [
        "id",
        "handler",
        "transports",
        "operations",
        "audience"
      ],
      "title": "Attribute",
      "type": "object"
    },
    "BleAttributeSpec": {
      "additionalProperties": false,
      "description": "Per-(attribute, ble-transport) wiring: one channel carries read/write/notify.",
      "properties": {
        "channel": {
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$",
          "title": "Channel",
          "type": "string"
        },
        "timeout": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timeout"
        }
      },
      "required": [
        "channel"
      ],
      "title": "BleAttributeSpec",
      "type": "object"
    },
    "BleChannelSpec": {
      "additionalProperties": false,
      "description": "One named (write, notify) characteristic pair on a BLE transport.\n\nChannels live on the *transport*; commands select one via\n``ble.<transport_id>.channel``.",
      "properties": {
        "notify": {
          "minLength": 1,
          "title": "Notify",
          "type": "string"
        },
        "write": {
          "minLength": 1,
          "title": "Write",
          "type": "string"
        }
      },
      "required": [
        "write",
        "notify"
      ],
      "title": "BleChannelSpec",
      "type": "object"
    },
    "BleCommandSpec": {
      "additionalProperties": false,
      "description": "Per-(command, ble-transport) channel routing and behavior block.\n\n``channel`` must name a channel declared on the BLE transport's\n``channels:`` map.",
      "properties": {
        "channel": {
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$",
          "title": "Channel",
          "type": "string"
        },
        "expects_response": {
          "default": true,
          "title": "Expects Response",
          "type": "boolean"
        },
        "timeout": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timeout"
        }
      },
      "required": [
        "channel"
      ],
      "title": "BleCommandSpec",
      "type": "object"
    },
    "BleDiscoverySpec": {
      "additionalProperties": false,
      "description": "Match criteria for a BLE advertisement (all fields optional, AND'd).\n\nThe generated SDK emits a ``default_ble_matcher(candidate)`` that returns\n``True`` only when every present criterion matches the advertisement.",
      "properties": {
        "manufacturer_id": {
          "anyOf": [
            {
              "maximum": 65535,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Manufacturer Id"
        },
        "name_prefix": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name Prefix"
        },
        "service_uuids": {
          "items": {
            "type": "string"
          },
          "title": "Service Uuids",
          "type": "array"
        }
      },
      "title": "BleDiscoverySpec",
      "type": "object"
    },
    "BleEventSpec": {
      "additionalProperties": false,
      "description": "Per-(event, ble-transport) subscribe wiring: one channel's notify stream.",
      "properties": {
        "channel": {
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$",
          "title": "Channel",
          "type": "string"
        },
        "timeout": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timeout"
        }
      },
      "required": [
        "channel"
      ],
      "title": "BleEventSpec",
      "type": "object"
    },
    "Command": {
      "additionalProperties": false,
      "description": "One request/response operation against the device.",
      "properties": {
        "audience": {
          "items": {
            "pattern": "^[a-z][a-z0-9_-]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Audience",
          "type": "array"
        },
        "ble": {
          "patternProperties": {
            "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$": {
              "$ref": "#/$defs/BleCommandSpec"
            }
          },
          "title": "Ble",
          "type": "object"
        },
        "capabilities": {
          "items": {
            "type": "string"
          },
          "title": "Capabilities",
          "type": "array"
        },
        "handler": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Handler"
        },
        "http": {
          "patternProperties": {
            "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$": {
              "$ref": "#/$defs/HttpCommandSpec"
            }
          },
          "title": "Http",
          "type": "object"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$",
          "title": "Id",
          "type": "string"
        },
        "idempotent": {
          "default": false,
          "title": "Idempotent",
          "type": "boolean"
        },
        "opcode": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Opcode"
        },
        "retries": {
          "default": 0,
          "minimum": 0,
          "title": "Retries",
          "type": "integer"
        },
        "session_required": {
          "default": false,
          "title": "Session Required",
          "type": "boolean"
        },
        "timeout": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timeout"
        },
        "transports": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Transports",
          "type": "array"
        }
      },
      "required": [
        "id",
        "handler",
        "transports",
        "audience"
      ],
      "title": "Command",
      "type": "object"
    },
    "Device": {
      "additionalProperties": false,
      "description": "Metadata for the target device.",
      "properties": {
        "audience": {
          "items": {
            "pattern": "^[a-z][a-z0-9_-]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Audience",
          "type": "array"
        },
        "display_name": {
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        },
        "firmware_min": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Firmware Min"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$",
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "display_name",
        "audience"
      ],
      "title": "Device",
      "type": "object"
    },
    "DiscoverySpec": {
      "additionalProperties": false,
      "description": "Optional top-level discovery configuration.\n\nLists at least one transport-family sub-block. Each present sub-block\ndrives generation of a corresponding ``make_<family>_scanner()`` and\n``default_<family>_matcher()`` in the SDK's ``scanners.py`` module.",
      "properties": {
        "ble": {
          "anyOf": [
            {
              "$ref": "#/$defs/BleDiscoverySpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "http": {
          "anyOf": [
            {
              "$ref": "#/$defs/HttpDiscoverySpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "DiscoverySpec",
      "type": "object"
    },
    "Event": {
      "additionalProperties": false,
      "description": "Stateless device emission primitive: a subscribe-only stream.\n\nDistinct from an attribute subscribe (which streams changes of a named,\nread/writable *value*): an event has no stored state \u2014 it is a\nfire-and-forget emission (e.g. \"button pressed\", \"recording started\"). The\nhandler declares a single ``payload`` type; the generated facade exposes\n``client.<namespace>.<event>.subscribe()`` (async-only).",
      "properties": {
        "audience": {
          "items": {
            "pattern": "^[a-z][a-z0-9_-]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Audience",
          "type": "array"
        },
        "ble": {
          "patternProperties": {
            "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$": {
              "$ref": "#/$defs/BleEventSpec"
            }
          },
          "title": "Ble",
          "type": "object"
        },
        "capabilities": {
          "items": {
            "type": "string"
          },
          "title": "Capabilities",
          "type": "array"
        },
        "handler": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Handler"
        },
        "http": {
          "patternProperties": {
            "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$": {
              "$ref": "#/$defs/HttpEventSpec"
            }
          },
          "title": "Http",
          "type": "object"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$",
          "title": "Id",
          "type": "string"
        },
        "transports": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Transports",
          "type": "array"
        }
      },
      "required": [
        "id",
        "handler",
        "transports",
        "audience"
      ],
      "title": "Event",
      "type": "object"
    },
    "HttpAttributeOp": {
      "additionalProperties": false,
      "description": "One HTTP read/write operation for an attribute \u2014 a command-shaped block.\n\nVerbs are explicit, never assumed: a non-REST device that *writes* via\n``GET`` (e.g. ``GET /setting?option=9``) sets ``method: GET`` with\n``query_from_request: true``, exactly like a command.",
      "properties": {
        "body_codec": {
          "default": "json",
          "enum": [
            "json",
            "none"
          ],
          "title": "Body Codec",
          "type": "string"
        },
        "method": {
          "default": "GET",
          "enum": [
            "GET",
            "POST",
            "PUT",
            "DELETE"
          ],
          "title": "Method",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "query_from_request": {
          "default": false,
          "title": "Query From Request",
          "type": "boolean"
        },
        "response_codec": {
          "default": "json",
          "enum": [
            "json",
            "none"
          ],
          "title": "Response Codec",
          "type": "string"
        },
        "timeout": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timeout"
        }
      },
      "required": [
        "path"
      ],
      "title": "HttpAttributeOp",
      "type": "object"
    },
    "HttpAttributeSpec": {
      "additionalProperties": false,
      "description": "Per-(attribute, http-transport) wiring: the ops this attribute supports here.",
      "properties": {
        "read": {
          "anyOf": [
            {
              "$ref": "#/$defs/HttpAttributeOp"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "subscribe": {
          "anyOf": [
            {
              "$ref": "#/$defs/HttpAttributeSubscribe"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "write": {
          "anyOf": [
            {
              "$ref": "#/$defs/HttpAttributeOp"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "HttpAttributeSpec",
      "type": "object"
    },
    "HttpAttributeSubscribe": {
      "additionalProperties": false,
      "description": "HTTP subscribe wiring for an attribute: native SSE, or explicit opt-in polling.\n\nPolling is never a surprise default \u2014 ``mode: poll`` must supply an\n``interval``. ``mode: sse`` opens one long-lived event stream instead.",
      "properties": {
        "interval": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Interval"
        },
        "mode": {
          "default": "sse",
          "enum": [
            "sse",
            "poll"
          ],
          "title": "Mode",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "timeout": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timeout"
        }
      },
      "required": [
        "path"
      ],
      "title": "HttpAttributeSubscribe",
      "type": "object"
    },
    "HttpCommandSpec": {
      "additionalProperties": false,
      "description": "Per-(command, http-transport) wire-format and behavior block.",
      "properties": {
        "body_codec": {
          "default": "json",
          "enum": [
            "json",
            "none"
          ],
          "title": "Body Codec",
          "type": "string"
        },
        "expects_response": {
          "default": true,
          "title": "Expects Response",
          "type": "boolean"
        },
        "method": {
          "enum": [
            "GET",
            "POST",
            "PUT",
            "DELETE"
          ],
          "title": "Method",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "query_from_request": {
          "default": false,
          "title": "Query From Request",
          "type": "boolean"
        },
        "response_codec": {
          "default": "json",
          "enum": [
            "json",
            "none"
          ],
          "title": "Response Codec",
          "type": "string"
        },
        "timeout": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timeout"
        }
      },
      "required": [
        "method",
        "path"
      ],
      "title": "HttpCommandSpec",
      "type": "object"
    },
    "HttpDiscoverySpec": {
      "additionalProperties": false,
      "description": "Probe-list configuration for HTTP discovery.\n\nUnlike BLE, HTTP discovery has nothing to listen for \u2014 the scanner\nmust be told which URLs to probe. ``base_urls`` is therefore\nrequired whenever this sub-block is present.",
      "properties": {
        "base_urls": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Base Urls",
          "type": "array"
        },
        "probe_path": {
          "default": "/",
          "minLength": 1,
          "title": "Probe Path",
          "type": "string"
        },
        "server_header_prefix": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Server Header Prefix"
        }
      },
      "required": [
        "base_urls"
      ],
      "title": "HttpDiscoverySpec",
      "type": "object"
    },
    "HttpEventSpec": {
      "additionalProperties": false,
      "description": "Per-(event, http-transport) subscribe wiring: native SSE, or explicit opt-in polling.\n\nIdentical shape to an attribute's subscribe block \u2014 an event *is* a\nsubscribe-only stream \u2014 but kept as its own model so the two primitives stay\nself-documenting. Polling is never a surprise default: ``mode: poll`` must\nsupply an ``interval``; ``mode: sse`` opens one long-lived event stream.",
      "properties": {
        "interval": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Interval"
        },
        "mode": {
          "default": "sse",
          "enum": [
            "sse",
            "poll"
          ],
          "title": "Mode",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "timeout": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timeout"
        }
      },
      "required": [
        "path"
      ],
      "title": "HttpEventSpec",
      "type": "object"
    },
    "Transport": {
      "additionalProperties": false,
      "description": "A wire transport (BLE / HTTP / serial / etc.) plus its codec.\n\nThe optional ``family`` field tags the transport for cross-validation:\nwhen set, commands riding this transport must supply the matching\nper-transport block (``http:`` for ``family=http``, ``ble:`` for\n``family=ble``). Loopback / unknown / null transports impose no such\nrequirement (this preserves the lightweight test-fixture style used\nin unit tests).",
      "properties": {
        "adapter": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adapter"
        },
        "auth": {
          "anyOf": [
            {
              "$ref": "#/$defs/TransportAuth"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "capabilities": {
          "additionalProperties": true,
          "title": "Capabilities",
          "type": "object"
        },
        "channels": {
          "patternProperties": {
            "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$": {
              "$ref": "#/$defs/BleChannelSpec"
            }
          },
          "title": "Channels",
          "type": "object"
        },
        "codec": {
          "title": "Codec",
          "type": "string"
        },
        "config": {
          "additionalProperties": true,
          "title": "Config",
          "type": "object"
        },
        "family": {
          "anyOf": [
            {
              "enum": [
                "loopback",
                "http",
                "ble"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Family"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$",
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "codec"
      ],
      "title": "Transport",
      "type": "object"
    },
    "TransportAuth": {
      "additionalProperties": false,
      "description": "Optional per-transport handshake recipe for session-required commands.",
      "properties": {
        "handler": {
          "title": "Handler",
          "type": "string"
        }
      },
      "required": [
        "handler"
      ],
      "title": "TransportAuth",
      "type": "object"
    },
    "Vendoring": {
      "additionalProperties": false,
      "description": "Explicit overrides for the import-closure walker.\n\nThe walker auto-discovers most files; these knobs handle edge cases\n(dynamic imports, intentionally vendored extras, exclusions).",
      "properties": {
        "exclude": {
          "items": {
            "type": "string"
          },
          "title": "Exclude",
          "type": "array"
        },
        "extra_include": {
          "items": {
            "type": "string"
          },
          "title": "Extra Include",
          "type": "array"
        }
      },
      "title": "Vendoring",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Top-level manifest: one device, its transports, and its operations.",
  "properties": {
    "attributes": {
      "items": {
        "$ref": "#/$defs/Attribute"
      },
      "title": "Attributes",
